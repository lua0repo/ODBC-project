import pyodbc

def fetch_data_from_odbc():
    # Define your connection string. Replace the placeholders with your actual database credentials.
    conn_str = 'DRIVER={ODBC Driver 17 for SQL Server};'  \
               'SERVER=your_server_name;' \
               'DATABASE=your_database_name;' \
               'UID=your_username;' \
               'PWD=your_password'
    
    try:
        # Establish connection
        conn = pyodbc.connect(conn_str)
        print("Connection successful!")

        # Create a cursor from the connection
        cursor = conn.cursor()

        # Define your SQL query
        query = "SELECT * FROM your_table_name"  # Adjust the query as per your database structure

        # Execute the query
        cursor.execute(query)

        # Fetch all results from the query
        rows = cursor.fetchall()

        # Check if rows were fetched
        if rows:
            # Display column headers (optional, but useful for large datasets)
            columns = [column[0] for column in cursor.description]
            print(f"{' | '.join(columns)}")

            # Loop through rows and print each row
            for row in rows:
                print(" | ".join(str(item) for item in row))
        else:
            print("No data found.")

    except pyodbc.Error as e:
        print("Error while connecting to the database or fetching data:", e)
    
    finally:
        # Ensure connection is closed properly
        if conn:
            conn.close()
            print("Connection closed.")

if __name__ == '__main__':
    fetch_data_from_odbc()
